FROM node:18-slim

WORKDIR /app

# Copy only scripts directory (which exists)
COPY scripts/ /app/scripts/

# Create logs directory at runtime
RUN mkdir -p /app/logs

# Make scripts executable
RUN chmod +x /app/scripts/*.sh || true

ENV INTERVAL_SECONDS=900

# Run the cron script
ENTRYPOINT ["/bin/bash", "-lc", "/app/scripts/run-cron.sh"]
