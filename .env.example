PORT=8080
CORS_ORIGINS=https://hht.ebbiehq.me
MAX_UPLOAD_MB=10
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
ANALYZE_DEADLINE_SECONDS=28
PROVIDER_REQUEST_TIMEOUT_SECONDS=18

PRIMARY_VISION_PROVIDER=groq
HOSTED_PROVIDER_ORDER=groq,openrouter,nvidia
GROQ_API_KEY=
GROQ_MODEL=llama-3.2-11b-vision-preview
GROQ_FALLBACK_MODEL=llama-3.2-90b-vision-preview

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_RUNAME=
EBAY_REFRESH_TOKEN=
EBAY_REFRESH_TOKEN_ISSUED_AT=
EBAY_AUTH_STATE=
EBAY_USER_SCOPES=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_PAYMENT_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_CURRENCY=USD
EBAY_LISTING_DURATION=GTC
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_SITE_ID=0

OPENROUTER_API_KEY=
# Open-source multimodal fallback; do not use the text-only openrouter/free router.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
DEMO_MODE=false

# Commerce Agent MVP: set DATABASE_URL in Heroku to the Supabase PostgreSQL URI.
# Local development falls back to this SQLite file when DATABASE_URL is absent.
DATABASE_URL=
COMMERCE_AGENT_DB=commerce_agent.sqlite3

# Optional NVIDIA NIM/OpenAI-compatible classifier. Leave blank to use deterministic rules.
NVIDIA_NIM_BASE_URL=
NVIDIA_NIM_API_KEY=
NVIDIA_CATEGORY_MODEL=
PRICING_CACHE_TTL_SECONDS=900
EBAY_TAXONOMY_ENABLED=false
SOLD_COMPS_API_URL=
SOLD_COMPS_CSV=
WORKER_POLL_SECONDS=10
WORKER_CONCURRENCY=4
GROQ_WORKER_PROVIDER_TIMEOUT_SECONDS=12
GROQ_WORKER_DEADLINE_SECONDS=30
NVIDIA_AUDIT_TIMEOUT_SECONDS=8

# Read-only full-catalog GetItem enrichment. Chunk size is capped at 20.
# Checkpoints live in the Commerce Agent database and can resume after restart.
ENRICHMENT_CHUNK_SIZE=20
ENRICHMENT_RATE_LIMIT_SECONDS=0.35
ENRICHMENT_MAX_RETRIES=3
ENRICHMENT_STALE_SECONDS=900
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Photo storage: disabled, ibm_cos (production), or supabase (also needs SUPABASE_SERVICE_ROLE_KEY and PHOTO_STORAGE_BUCKET)
PHOTO_STORAGE_PROVIDER=disabled
IBM_COS_ENDPOINT=
IBM_COS_BUCKET=
IBM_COS_ACCESS_KEY_ID=
IBM_COS_SECRET_ACCESS_KEY=
IBM_COS_REGION=us-standard
PHOTO_URL_TTL_SECONDS=3600

# Required to bind the existing eBay account during the controlled pilot.
# Leave both blank to keep all seller operations locked.
SELLER_BOOTSTRAP_AUTH_USER_ID=
EBAY_ACCOUNT_ID=
# Bind the already-connected eBay account only to this Supabase user for the
# controlled pilot. Leave blank to keep all seller operations locked.
SELLER_BOOTSTRAP_AUTH_USER_ID=
EBAY_ACCOUNT_ID=
