# Copy this file to .env and fill in real values. Never commit .env.
# The app runs in DEMO MODE until at least one vision key is set.

# ====== Vision providers (set ONE to switch from demo mode) ======
# Gemini (free tier, recommended): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Azure Foundry / Azure OpenAI (fallback vision provider):
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ====== File storage (optional, for image hosting) ======
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=

# ====== Catalog database (optional) ======
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT=
APPWRITE_DATABASE_ID=default

# ====== Server ======
PORT=8080
GUNICORN_WORKERS=4

# ====== Continue.dev autocomplete (local, free) — see FREE_AI_SETUP.md ======
GROQ_API_KEY=
