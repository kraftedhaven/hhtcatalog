# Copy this file to .env for local Docker development. Never commit .env.
# The app runs in demo mode until GEMINI_API_KEY or Azure OpenAI values are set.

# Server
PORT=8080
CORS_ORIGINS=http://localhost:5173
LOCAL_UPLOAD_DIR=/data/uploads
SAVE_UPLOADS=true
MAX_UPLOAD_MB=10
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Gemini vision provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Azure OpenAI vision provider
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# DigitalOcean Spaces image persistence
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=

# Appwrite inventory persistence
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=default
APPWRITE_COLLECTION_ID=inventory
